---
import Base from '../../layouts/Base.astro';
import Crumbs from '../../components/Crumbs.astro';
import Cta from '../../components/Cta.astro';
import Disclosure from '../../components/Disclosure.astro';
import Faq from '../../components/Faq.astro';
import nordvpn from '../../data/nordvpn.js';
import competitors from '../../data/competitors.js';
import { site, legal } from '../../config.js';

const n = nordvpn;
const t = n.pricing.tiers;
const top3 = competitors.filter((c) => ['expressvpn', 'surfshark', 'protonvpn'].includes(c.id));

const faqs = [
  { q: 'Is NordVPN worth it in 2026?', a: `For most people, yes. At $${t[0].twoYear} a month on the two-year Basic plan it is not the cheapest VPN, but it is the one that clears the bar on speed, unblocking, apps, network size and support simultaneously. The main caveat is renewal pricing, which rises sharply after the introductory term.` },
  { q: 'How much does NordVPN cost?', a: `The Basic plan is $${t[0].monthly} monthly, $${t[0].yearly} a month on an annual subscription, or $${t[0].twoYear} a month on the two-year plan ($${t[0].twoYearTotal} for ${t[0].twoYearMonths} months including three extra months). Complete is $${t[1].twoYear} and Prime is $${t[2].twoYear} on the same two-year term.` },
  { q: 'Does NordVPN keep logs?', a: `No. NordVPN operates a no-activity-logs policy that has been independently audited four times, most recently by Deloitte. Its servers are RAM-only, so nothing persists across a reboot, and it is registered in Panama, which has no mandatory data-retention law.` },
  { q: 'How many devices can I use NordVPN on?', a: `Ten simultaneously on a single subscription, with apps for Windows, macOS, Linux, Android, iOS, ChromeOS, Android TV, tvOS, Fire TV, PlayStation, Xbox, Nintendo Switch and routers. A router connection counts as one and covers every device behind it.` },
  { q: 'Does NordVPN work with Netflix?', a: `Yes, and it is one of the most reliable services for it. Its large network means more IP ranges to rotate when Netflix flags one, and SmartPlay handles the DNS side automatically. It reliably unblocks the US, UK, Canadian, Japanese and Australian libraries.` },
  { q: 'What is NordWhisper?', a: `A NordVPN protocol designed to establish connections on networks that block or shape ordinary VPN traffic. Modern censorship targets protocols rather than destinations, and NordWhisper disguises its handshake to resemble ordinary HTTPS. It is the first thing to try on hotel, campus, corporate or state-filtered networks.` },
  { q: 'Is there a NordVPN free trial?', a: `There is a three-day free trial for new Android users through Google Play. On every other platform the route is the 30-day money-back guarantee, which applies to all plans and is honoured without argument through live chat.` },
  { q: 'Does NordVPN slow down my internet?', a: `On a nearby server using NordLynx, typically by 5 to 15 percent. Larger losses usually mean the server is far away, congested, or that OpenVPN is selected where NordLynx would work.` },
  { q: 'NordVPN vs ExpressVPN: which is better?', a: `NordVPN wins on value. It is cheaper on equivalent terms, runs more than twice the servers, covers 150 countries to ExpressVPN's 105, and adds Meshnet. ExpressVPN wins on app polish and is the better pick if you want the least friction and are happy paying a premium for it.` },
  { q: 'Is NordVPN safe?', a: `Yes. It uses AES-256-GCM encryption, runs RAM-only servers, has an audited no-logs policy, includes a kill switch and DNS leak protection, and is registered in Panama. It is among the most heavily scrutinised VPNs in the industry, which is a point in its favour.` },
];

const reviewSchema = {
  '@context': 'https://schema.org',
  '@type': 'Review',
  itemReviewed: {
    '@type': 'SoftwareApplication',
    name: 'NordVPN',
    applicationCategory: 'SecurityApplication',
    operatingSystem: 'Windows, macOS, Linux, Android, iOS, ChromeOS, Android TV, tvOS, Fire OS',
    offers: { '@type': 'Offer', price: t[0].twoYear, priceCurrency: 'USD' },
  },
  reviewRating: { '@type': 'Rating', ratingValue: String(n.score.overall), bestRating: '5', worstRating: '1' },
  author: { '@type': 'Organization', name: site.name },
  datePublished: site.factsVerifiedOn,
};
---
<Base
  title="NordVPN review 2026: tested, downsides included"
  description={`Hands-on NordVPN review for 2026. Pricing from $${t[0].twoYear}/month, ${n.network.servers} servers in ${n.network.countries} countries, speed and streaming results, and the six things we do not like.`}
  slug="/reviews/nordvpn"
  schema={reviewSchema}
>
  <div class="wrap">
    <Crumbs items={[{ label: 'Reviews', href: '/reviews/nordvpn' }]} />

    <article class="narrow">
      <p class="count">Last verified {new Date(site.factsVerifiedOn).toLocaleDateString('en-GB', { day: 'numeric', month: 'long', year: 'numeric' })} &middot; {Object.keys(n.score).length - 1} categories scored</p>
      <h1>NordVPN review 2026: tested, with the downsides included</h1>
      <p class="hub-intro">NordVPN is the VPN we recommend to most people, and it has held that position for several years running. This review explains why, and — more usefully — where it falls short, because the six things on the cons list are the reason some readers should buy something else.</p>

      <Disclosure variant="long" />

      <div class="verdict">
        <h3>Our verdict &mdash; {n.score.overall} / 5</h3>
        <p>{n.verdict}</p>
      </div>

      <Cta slug="reviews-nordvpn" />

      <div class="scores">
        <div class="score-row"><span>Speed</span><span class="bar"><span style={`width:${n.score.speed * 20}%`}></span></span><span class="val">{n.score.speed}</span></div>
        <div class="score-row"><span>Privacy</span><span class="bar"><span style={`width:${n.score.privacy * 20}%`}></span></span><span class="val">{n.score.privacy}</span></div>
        <div class="score-row"><span>Streaming</span><span class="bar"><span style={`width:${n.score.streaming * 20}%`}></span></span><span class="val">{n.score.streaming}</span></div>
        <div class="score-row"><span>Ease of use</span><span class="bar"><span style={`width:${n.score.easeOfUse * 20}%`}></span></span><span class="val">{n.score.easeOfUse}</span></div>
        <div class="score-row"><span>Value</span><span class="bar"><span style={`width:${n.score.value * 20}%`}></span></span><span class="val">{n.score.value}</span></div>
        <div class="score-row"><span>Support</span><span class="bar"><span style={`width:${n.score.support * 20}%`}></span></span><span class="val">{n.score.support}</span></div>
      </div>

      <h2 id="snapshot">NordVPN at a glance</h2>
      <div class="tablewrap">
        <table>
          <tbody>
            <tr><th>Provider</th><td>{n.name}, operated by {n.vendor}</td></tr>
            <tr><th>Jurisdiction</th><td>{n.jurisdiction} &mdash; {n.hqNote}</td></tr>
            <tr><th>Servers</th><td>{n.network.servers} servers ({n.network.serversExactPublished} published) across {n.network.countries} countries and {n.network.locations} locations</td></tr>
            <tr><th>Devices</th><td>{n.devices.simultaneous} simultaneous connections</td></tr>
            <tr><th>Protocols</th><td>{n.protocols.map((p) => p.name).join(', ')}</td></tr>
            <tr><th>Encryption</th><td>{n.encryption}</td></tr>
            <tr><th>Cheapest plan</th><td class="hi">${t[0].twoYear}/month on the two-year Basic plan (${t[0].twoYearTotal} for {t[0].twoYearMonths} months)</td></tr>
            <tr><th>Money back</th><td>{n.pricing.guarantee}</td></tr>
            <tr><th>Logging</th><td>No activity logs, independently audited four times</td></tr>
            <tr><th>Founded</th><td>{n.founded}</td></tr>
          </tbody>
        </table>
      </div>

      <div class="proscons">
        <div class="pc pros">
          <h3>What we liked</h3>
          <ul>{n.pros.map((p) => <li>{p}</li>)}</ul>
        </div>
        <div class="pc cons">
          <h3>What we did not</h3>
          <ul>{n.cons.map((c) => <li>{c}</li>)}</ul>
        </div>
      </div>

      <h2 id="pricing">Pricing: the three plans and the renewal trap</h2>
      <p>NordVPN sells three tiers, each available monthly, annually or on a two-year term. The two-year plans currently include three extra months, which is why the first billing period is {t[0].twoYearMonths} months rather than 24.</p>

      <div class="tablewrap">
        <table>
          <thead>
            <tr><th>Plan</th><th>Monthly</th><th>1 year</th><th>2 years</th><th>2-year total</th></tr>
          </thead>
          <tbody>
            {t.map((tier) => (
              <tr>
                <td><strong>{tier.name}</strong></td>
                <td class="num">${tier.monthly}</td>
                <td class="num">${tier.yearly}</td>
                <td class="num hi">${tier.twoYear}</td>
                <td class="num">${tier.twoYearTotal}</td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>

      {t.map((tier) => (
        <div class="verdict">
          <h3>{tier.name} &mdash; {tier.bestFor}</h3>
          <p>{tier.pitch}</p>
          {tier.extras.length > 0 && <p><strong>Adds:</strong> {tier.extras.join('; ')}.</p>}
          <p><strong>Renewal:</strong> {tier.renewal}.</p>
        </div>
      ))}

      <div class="note">
        <strong>The renewal trap is the single most important thing to know about NordVPN pricing.</strong>
        The $3.49 figure is an introductory rate. When the term ends, Basic renews at roughly $139 a year and Complete at roughly $219. NordVPN emails before charging, but the email is easy to miss. Set a calendar reminder for a fortnight before renewal and decide then, rather than discovering the charge afterwards.
      </div>

      <p>{n.pricing.note}</p>
      <p>{n.pricing.payment} {n.pricing.trial}.</p>

      <Cta
        slug="reviews-nordvpn-pricing"
        title={`Basic two-year plan: $${t[0].twoYear}/month`}
        body={`$${t[0].twoYearTotal} upfront for ${t[0].twoYearMonths} months, including three extra. ${n.pricing.guarantee}.`}
      />

      <h2 id="speed">Speed and performance</h2>
      <p>Speed is where NordVPN has pulled clearly ahead of the field, and the reason is NordLynx. It is a WireGuard-based protocol with a fraction of the code of OpenVPN, which means encryption and decryption are cheaper and the handshake is much lighter.</p>
      <p>In practice this means a nearby NordLynx server typically costs between 5 and 15 percent of your download speed. On a fibre connection that is invisible. Long-distance connections cost more — Sydney to Los Angeles adds roughly 150 milliseconds of latency — but that is physics rather than a NordVPN limitation, and every provider pays the same toll.</p>
      <p>NordVPN also operates 10 Gbps servers across its network, which matters for congestion at peak hours rather than for raw throughput on a home connection. The practical benefit is that a London server at 9pm is not dramatically worse than the same server at 9am.</p>

      <h2 id="privacy">Privacy, logging and jurisdiction</h2>
      <p>{n.hqNote}</p>
      <p>Panama is the relevant fact. It has no mandatory data-retention law and sits outside the Fourteen Eyes intelligence-sharing arrangement, which means there is no legal mechanism compelling NordVPN to retain connection data in the first place. A provider that keeps nothing cannot be compelled to produce it.</p>
      <p>Three things back the policy up beyond a privacy policy page. First, the no-logs commitment has been independently audited four times, most recently by Deloitte. Second, servers are RAM-only, so there is no disk for data to persist on across a reboot. Third, NordVPN has a documented history of having nothing useful to hand over when tested.</p>
      <p>For readers who want the strongest privacy posture in the industry regardless of everything else, <a href="/compare/nordvpn-vs-mullvad">Mullvad</a> is arguably better: no email address, no account, just a number. NordVPN is the better general-purpose choice.</p>

      <h2 id="features">Features worth caring about</h2>
      <ul>
        {n.features.map((f) => <li><strong>{f.name}.</strong> {f.note}</li>)}
      </ul>

      <h3>Specialty servers</h3>
      <div class="tablewrap">
        <table>
          <thead><tr><th>Server type</th><th>What it does</th></tr></thead>
          <tbody>
            {n.specialtyServers.map((s) => <tr><td><strong>{s.name}</strong></td><td>{s.note}</td></tr>)}
          </tbody>
        </table>
      </div>

      <h3>Protocols</h3>
      <div class="tablewrap">
        <table>
          <thead><tr><th>Protocol</th><th>Based on</th><th>When to use it</th></tr></thead>
          <tbody>
            {n.protocols.map((p) => <tr><td><strong>{p.name}</strong></td><td>{p.base}</td><td>{p.note}</td></tr>)}
          </tbody>
        </table>
      </div>

      <h2 id="streaming">Streaming and unblocking</h2>
      <p>NordVPN reliably unblocks {n.streaming.worksWith.slice(0, 6).join(', ')} and several others. {n.streaming.tech}</p>
      <p>The reason it succeeds where smaller providers fail is arithmetic. Streaming services block VPNs by maintaining lists of IP ranges belonging to known providers. When a range is flagged, everyone using it is blocked at once. A provider with {n.network.servers} servers across {n.network.locations} locations has far more addresses to rotate through than one with four hundred, and it has multiple cities in each major country, so a blocked London range can be replaced with Manchester, Edinburgh or Glasgow.</p>
      <div class="note info">
        <strong>Full details in the country guides.</strong>
        Server choice and failure modes differ by service. See <a href="/watch/netflix-us/india">watching Netflix US from India</a>, <a href="/watch/bbc-iplayer/australia">BBC iPlayer from Australia</a>, <a href="/watch/hulu/united-kingdom">Hulu from the UK</a>, or the <a href="/streaming">full streaming index</a>.
      </div>

      <h2 id="apps">Apps and device support</h2>
      <p>One subscription covers {n.devices.simultaneous} simultaneous connections. NordVPN has native apps for {n.devices.platforms.join(', ')}.</p>
      <p>The Windows and macOS clients are the most complete, and are the only platforms with full Threat Protection Pro including file malware scanning. The mobile apps are excellent, with Android adding a three-day free trial. Consoles and Roku require a router-level setup, since they have no VPN client — see the <a href="/devices">device guides</a> for specifics on each platform.</p>

      <h2 id="comparison">How it compares</h2>
      <div class="tablewrap">
        <table>
          <thead>
            <tr><th>Provider</th><th>Servers</th><th>Countries</th><th>Devices</th><th>Best price</th><th>Free tier</th></tr>
          </thead>
          <tbody>
            <tr>
              <td class="hi"><strong>NordVPN</strong></td>
              <td>{n.network.servers}</td><td>{n.network.countries}</td><td>{n.devices.simultaneous}</td>
              <td class="num">${t[0].twoYear}/mo</td><td>3-day Android trial</td>
            </tr>
            {top3.map((c) => (
              <tr>
                <td><a href={`/compare/nordvpn-vs-${c.id}`}>{c.name}</a></td>
                <td>{c.servers}</td><td>{c.countries}</td><td>{c.devices}</td>
                <td class="num">{c.bestPrice}</td><td>{c.freeTier}</td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
      <p>See <a href="/compare">all {competitors.length} head-to-head comparisons</a>, or <a href="/nordvpn/alternatives">our picks for the best NordVPN alternatives</a>.</p>

      <h2 id="support">Support and refunds</h2>
      <p>{n.pricing.guarantee}, honoured through live chat without meaningful friction. Support will usually ask why you are cancelling and may offer a partial refund or a free month; a short answer is enough and you are not obliged to negotiate. Refunds typically reach your card within about ten business days.</p>
      <p>One detail catches people out: subscriptions bought through the Apple App Store or Google Play follow that store's refund rules rather than NordVPN's. Buy directly from NordVPN if the guarantee matters to you.</p>

      <h2 id="who">Who should not buy NordVPN</h2>
      <p>This matters more than the praise. NordVPN is the wrong choice if:</p>
      <ul>
        <li><strong>You have more than ten devices.</strong> <a href="/compare/nordvpn-vs-surfshark">Surfshark</a> offers unlimited simultaneous connections and is cheaper.</li>
        <li><strong>You want the smallest possible data footprint.</strong> <a href="/compare/nordvpn-vs-mullvad">Mullvad</a> needs no email address and accepts cash by post.</li>
        <li><strong>You only want a free VPN.</strong> <a href="/guides/nordvpn-vs-free-vpn">Proton VPN Free</a> is genuinely good and costs nothing.</li>
        <li><strong>You need one month only.</strong> At ${t[0].monthly}, NordVPN's monthly plan is among the most expensive available.</li>
        <li><strong>You are in mainland China and need reliability above all.</strong> <a href="/compare/nordvpn-vs-astrill">Astrill</a> is the specialist for that specific problem.</li>
      </ul>

      <h2 id="bottom">The bottom line</h2>
      <p>{n.verdict}</p>

      <Cta slug="reviews-nordvpn-verdict" />

      <Faq faqs={faqs} />

      <p class="disclosure" style="margin-top:2rem">{legal.specDisclaimer}</p>
    </article>
  </div>
</Base>
