---
import Base from '../../layouts/Base.astro';
import Crumbs from '../../components/Crumbs.astro';
import Disclosure from '../../components/Disclosure.astro';
import Cta from '../../components/Cta.astro';
import countries from '../../data/countries.js';
import { site } from '../../config.js';

const byRegion = countries.reduce((acc, c) => {
  (acc[c.region] ??= []).push(c);
  return acc;
}, {});
const regions = Object.keys(byRegion).sort();
const riskLabel = { low: 'Open internet', medium: 'Some filtering', high: 'Heavy restrictions' };
---
<Base
  title={`Best VPN by country: ${countries.length} guides`}
  description={`Country-by-country VPN guides for ${countries.length} markets \u2014 what is blocked, retention law, local streaming services, which servers to pick and whether a VPN is legal where you are.`}
  slug="/vpn"
  ogType="website"
>
  <div class="wrap">
    <Crumbs items={[{ label: 'VPN by country', href: '/vpn' }]} />
    <p class="count">{countries.length} countries &middot; verified {new Date(site.factsVerifiedOn).toLocaleDateString('en-GB', { day: 'numeric', month: 'long', year: 'numeric' })}</p>
    <h1>Best VPN by country</h1>
    <p class="hub-intro">A VPN recommendation that ignores where you live is not much use. Each guide below covers the specific censorship environment, data-retention law, local streaming services, realistic server choice and speeds for that market &mdash; not a rewritten version of the same page.</p>

    <Disclosure />

    <Cta slug="hub-country" compact />

    {regions.map((region) => (
      <>
        <h2>{region}</h2>
        <div class="grid">
          {byRegion[region].map((c) => (
            <a class="card" href={`/vpn/${c.id}`}>
              <p class="meta">{riskLabel[c.risk]}</p>
              <h3>{c.name}</h3>
              <p>{c.popular.slice(0, 3).join(' &middot; ')}</p>
            </a>
          ))}
        </div>
      </>
    ))}

    <h2>Which countries restrict VPNs?</h2>
    <p>The overwhelming majority of these markets allow VPN use without restriction. The exceptions and grey areas are covered in detail on our <a href="/legal">VPN legality index</a>, which covers {countries.filter((c) => c.risk !== 'low').length} of the countries above plus several more.</p>
  </div>
</Base>
