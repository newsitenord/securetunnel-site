{
  "name": "securetunnel-vpn-site",
  "type": "module",
  "version": "2.0.0",
  "private": true,
  "engines": {
    "node": ">=20.9.0"
  },
  "scripts": {
    "dev": "next dev --hostname 0.0.0.0",
    "prebuild": "npm run content:check",
    "build": "next build --webpack",
    "start": "next start --hostname 0.0.0.0",
    "content:check": "node scripts/content-check.mjs",
    "content:new": "node scripts/content-new.mjs",
    "test": "tsx --test tests/*.test.*",
    "audit": "tsx scripts/audit-next.jsx",
    "verify": "npm run test && npm run build && npm run audit",
    "predev": "npm run content:check",
    "pretest": "npm run content:check",
    "test:browser": "playwright test",
    "audit:http": "node scripts/check-http.mjs"
  },
  "dependencies": {
    "next": "16.3.6",
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "cheerio": "1.0.0",
    "tsx": "^4.20.0"
  }
}
